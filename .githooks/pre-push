#!/usr/bin/env sh
set -eu
guard="$(git rev-parse --show-toplevel)/scripts/Check-PublicSource.ps1"
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  if ! pwsh -NoProfile -File "$guard" -Mode Commit -Revision "$local_oid"; then
    echo "Push blocked: proposed source tip failed the public-source check." >&2
    exit 1
  fi
  base_args=""
  case "$remote_oid" in *[!0]*) base_args="-BaseRevision $remote_oid" ;; esac
  if ! pwsh -NoProfile -File "$(git rev-parse --show-toplevel)/scripts/Run-SecretAudit.ps1" -Mode Commit -Revision "$local_oid" $base_args; then
    echo "Push blocked: pinned secret audit failed or is unavailable." >&2
    exit 1
  fi
done
